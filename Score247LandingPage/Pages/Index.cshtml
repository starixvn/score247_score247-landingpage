@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<section class="header-area">
    <div class="navbar-area">
        <div class="page-container nav-container">
            <a class="logo"><img src="~/images/Logo.png" alt="Logo" /></a>
            <nav class="navbar navbar-expand-lg">
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarEight" aria-controls="navbarEight" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="icon-hambuger"></span>
                </button>
                <div class="collapse navbar-collapse sub-menu-bar" id="navbarEight">
                    <ul class="navbar-nav ml-auto">
                        <li class="nav-item">
                            <a class="page-scroll" href="#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#helpcenter">Help Center</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#ratingreviews">Rating & Reviews</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#contact">Contact</a>
                        </li>
                    </ul>
                </div>
                <div class="dropdown language">
                    <button class="btn dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="flag-eng"></span>
                        <span class="icon-arrow-down"></span>
                    </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <a class="dropdown-item" href="#"><span class="flag-cn"></span>中文</a>
                        <a class="dropdown-item" href="#"><span class="flag-id"></span>Bahasa Indonesia</a>
                        <a class="dropdown-item" href="#"><span class="flag-my"></span>മലേഷ്യൻ</a>
                        <a class="dropdown-item" href="#"><span class="flag-vn"></span>Tiếng Việt</a>
                        <a class="dropdown-item" href="#"><span class="flag-th"></span>ไทย</a>
                        <a class="dropdown-item active" href="#"><span class="flag-eng"></span>English</a>
                    </div>
                </div>
            </nav>
        </div>
    </div>
    <div class="banner">
        <div class="page-container banner-container">
            <div class="banner-left">
                <h2 class="banner-title">The most complete <span class="text-orange">football app</span> on the market</h2>
                <p class="banner-content">
                    It is easy to follow your preferences. From goals to cards, fixtures to final results, statistics to breaking news, Score247 will keep you posted with the up-to-the-minute information
                </p>
                <div class="banner-buttons">
                    <button class="btn-white">App store</button>
                    <button class="btn-white-outline">Play store</button>
                </div>
            </div>
            <div class="banner-right">
                <div class="device-holder">
                    <div class="device-holder-inner">
                        <div id="banner-carousel" class="owl-carousel owl-theme">
                            <div class="item"><img src="~/images/banner/banner1.png" /></div>
                            <div class="item"><img src="~/images/banner/banner2.png" /></div>
                            <div class="item"><img src="~/images/banner/banner3.png" /></div>
                            <div class="item"><img src="~/images/banner/banner4.png" /></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="features" class="features">
    <h1 class="page-title feature-title">Features</h1>
    <div class="page-container features-container">
        <div class="features-image">
            <img src="~/images/banner1.png" />
        </div>
        <div class="features-list">
            <div class="block">
                <div class="block-circle">
                    <span class="icon-real-time-update"></span>
                </div>
                <div>
                    <h1 class="block-title">Real-time updates</h1>
                    <p class="block-content">
                        Follow every moment of every match. Whether a goal is scored, red card issued, set or period is over, you will know at the same time as the live audience.
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-ball-tracker-visualization"></span>
                </div>
                <div>
                    <h1 class="block-title">Ball tracker visualization</h1>
                    <p class="block-content">
                        Follow every moment of every match. Whether a goal is scored, red card issued, set or period is over
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-rich-odds"></span>
                </div>
                <div>
                    <h1 class="block-title">Rich odds comparison & odds movement</h1>
                    <p class="block-content">
                        Supply plenty of odds values from different providers, and their movements throughout the offering periods
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-multiple-language"></span>
                </div>
                <div>
                    <h1 class="block-title">Multiple languages and time zones</h1>
                    <p class="block-content">
                        Support the 6 most widely used languages in Asia along with a convenient time zone selector. The data now can be displayed in your favored language, with an appropriate time frame
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="page-container features-container">
        <div class="features-list">
            <div class="block">
                <div class="block-circle">
                    <span class="icon-tv-channel"></span>
                </div>
                <div>
                    <h1 class="block-title">TV channels</h1>
                    <p class="block-content">
                        Want to watch the game on TV? Use this to find out the available channels in your country and their broadcast schedules
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-social"></span>
                </div>
                <div>
                    <h1 class="block-title">Social</h1>
                    <p class="block-content">
                        Have something to talk about the last match? Don't keep it to yourself. Try connecting with other users via our community - share your thoughts and listen to theirs
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-calendar1"></span>
                </div>
                <div>
                    <h1 class="block-title">Calendar</h1>
                    <p class="block-content">
                        Easily get hold of the upcoming event schedule, as well as the one that has already taken place
                    </p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-no-ads"></span>
                </div>
                <div>
                    <h1 class="block-title">No ads</h1>
                    <p class="block-content">
                        Feel free to enjoy our services without bothering about annoying advertisements
                    </p>
                </div>
            </div>
        </div>
        <div class="features-image">
            <img src="~/images/banner1.png" />
        </div>
    </div>
</div>
