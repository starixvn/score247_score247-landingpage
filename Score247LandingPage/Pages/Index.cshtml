@page
@model IndexModel

@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Home";
}
<section class="header-area">
    <div class="navbar-area">
        <div class="page-container nav-container">
            <a class="logo"><img src="~/images/Logo.png" alt="Logo" /></a>
            <nav class="navbar navbar-expand-lg">
                <button class="navbar-toggler" id="hambugerBox">
                    <div class="hambuger" id="hambugerIcon">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>
                <div class="sub-menu-bar" id="sidebar">
                    <ul class="navbar-nav">
                        <li class="nav-item active">
                            <a class="page-scroll" href="#home">@Localizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#features">@Localizer["Features"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#helpcenter">@Localizer["HelpCenter"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="page-scroll" href="#contact">@Localizer["Contact"]</a>
                        </li>
                    </ul>
                </div>
                <lang-nav></lang-nav>
            </nav>
        </div>
    </div>
    <div class="banner" id="home">
        <div class="page-container banner-container">
            <div class="banner-left">
                <h2 class="banner-title">@Localizer["AppIntro"]</h2>
                <p class="banner-content">
                    @Localizer["AppIntroContent"]
                </p>
                <button class="btn-white" onclick="window.open('https://apps.apple.com/us/app/score247/id1490241313?ls=1', '_blank')">App store</button>
            </div>
            <div class="banner-right">
                <div class="device-holder">
                    <div class="device-holder-inner">
                        <div id="banner-carousel" class="owl-carousel owl-theme">
                            <div class="item"><img src="~/images/banner/scores.png" alt="Scores Page" /></div>
                            <div class="item"><img src="~/images/banner/info.png" alt="Info" /></div>
                            <div class="item"><img src="~/images/banner/tracker.png" alt="Tracker" /></div>
                            <div class="item"><img src="~/images/banner/statistic.png" alt="Statistic" /></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="features" class="features">
    <h1 class="page-title feature-title">@Localizer["Features"]</h1>
    <div class="page-container features-container">
        <div class="features-image">
            <img src="~/images/linesup.png" alt="Features 1" />
        </div>
        <div class="features-list">
            <div class="block">
                <div class="block-circle">
                    <span class="icon-real-time-update"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["RealTimeUpdates"]</h1>
                    <p class="block-content"> @Localizer["RealTimeUpdatesDetail"]</p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-ball-tracker-visualization"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["BallTrackerVisualization"]</h1>
                    <p class="block-content">@Localizer["BallTrackerVisualizationDetail"]</p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-multiple-language"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["MultipleLanguagesAndTimeZones"]</h1>
                    <p class="block-content">@Localizer["MultipleLanguagesAndTimeZonesDetail"]</p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-tv-channel"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["TVChannels"]</h1>
                    <p class="block-content">@Localizer["TVChannelsDetail"]</p>
                </div>
            </div>
        </div>
    </div>
    <div class="page-container features-container">
        <div class="features-list">

            <div class="block">
                <div class="block-circle">
                    <span class="icon-social"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["Social"]</h1>
                    <p class="block-content">@Localizer["SocialDetail"]</p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-calendar1"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["Calendar"]</h1>
                    <p class="block-content">@Localizer["CalendarDetail"]</p>
                </div>
            </div>

            <div class="block">
                <div class="block-circle">
                    <span class="icon-no-ads"></span>
                </div>
                <div class="feature">
                    <h1 class="block-title">@Localizer["NoAds"]</h1>
                    <p class="block-content">@Localizer["NoAdsDetail"]</p>
                </div>
            </div>
        </div>
        <div class="features-image">
            <img src="~/images/h2h.png" alt="Features 2" />
        </div>
    </div>
</div>
<div id="helpcenter" class="helpcenter">
    <div class="helpcenter-container">
        <h1 class="page-title">@Localizer["HowCanWeHelpYou"]</h1>
        <div class="search-box">
            <input type="text" class="search-text" aria-label="Search" placeholder="@Localizer["TypeKeywordToFindAnswer"]" />
            <span class="icon-search"></span>
        </div>
        <ul class="list-qa">
            <li class="qa">
                <h2 class="question">@Localizer["Question1"]</h2>
                <p class="answer answer-short">@Localizer["Question1Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question2"]</h2>
                <p class="answer answer-short">@Localizer["Question2Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question3"]</h2>
                <p class="answer answer-short">@Localizer["Question3Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question4"]</h2>
                <p class="answer answer-short">@Localizer["Question4Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question5"]</h2>
                <p class="answer answer-short">@Localizer["Question5Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question6"]</h2>
                <p class="answer answer-short">@Localizer["Question6Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question7"]</h2>
                <p class="answer answer-short">@Localizer["Question7Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question8"]</h2>
                <p class="answer answer-short">@Localizer["Question8Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question9"]</h2>
                <p class="answer answer-short">@Localizer["Question9Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question10"]</h2>
                <p class="answer answer-short">@Localizer["Question10Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question11"]</h2>
                <p class="answer answer-short">@Localizer["Question11Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question12"]</h2>
                <p class="answer answer-short">@Localizer["Question12Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question13"]</h2>
                <p class="answer answer-short">@Localizer["Question13Answer"]</p>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question14"]</h2>
                <ul class="answer answer-short">@Localizer["Question14Answer"]</ul>
            </li>
            <li class="qa">
                <h2 class="question">@Localizer["Question15"]</h2>
                <p class="answer answer-short">@Localizer["Question15Answer"]</p>
            </li>
        </ul>
    </div>
</div>
<div id="contact" class="contact page-container">
    <div class="contact-intro">
        <h1 class="page-title">@Localizer["GetInTouchWithUs"]</h1>
        <p class="get-in-touch">@Localizer["GetInTouchWithUsDetail"]</p>
    </div>

    <div class="contact-container">
        <form class="contact-form">
            <input type="text" class="contact-control" aria-label="Email Address" placeholder="@Localizer["YourEmailAddress"]" />
            <input type="text" class="contact-control" aria-label="Subject" placeholder="@Localizer["Subject"]" />
            <textarea class="contact-control message" aria-label="Message" placeholder="@Localizer["Message"]"></textarea>
            <button class="btn-send">@Localizer["SendMessage"]</button>
        </form>
    </div>
</div>
<footer class="copyright">@Localizer["CopyrightText"]</footer>